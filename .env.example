# Copy to .env and change SECRET_KEY before running anywhere but your own machine.
SECRET_KEY="replace-with-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="metromind"
# SQLITE_FALLBACK_PATH defaults to backend/metromind.db

# Folder of the fine-tuned Hugging Face model the API serves (defaults to models/classifier)
# MODEL_DIR="models/classifier"

# Initial routing threshold in %. Pick it with research/evaluate.py; admins can change it in Settings.
DEFAULT_CONFIDENCE_THRESHOLD=70.0

SEED_DEMO_USERS=true
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend (frontend/.env): VITE_API_URL="http://localhost:8000"
